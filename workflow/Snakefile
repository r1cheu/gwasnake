# GWAS: sample preparation, PCA, LOCO association, and Manhattan plots.
configfile: "config/config.yaml"


with open(config["phenotype"], "r") as f:
    header = f.readline().strip().split("\t")
    if header[:2] != ["FID", "IID"]:
        raise ValueError(
            "Phenotype file must be tab-separated and start with FID and IID."
        )
PHENOTYPE = config["phenotypes"]


include: "rules/prepare.smk"
include: "rules/gwas.smk"


onstart:
    print(f"Phenotypes: {PHENOTYPE}")


rule all:
    default_target: True
    input:
        expand(
            "results/{run_id}/{phenotype}/manhattan_{suffix}.png",
            run_id=config["run_id"],
            phenotype=PHENOTYPE,
            suffix=["A", "D", "AD"],
        ),
