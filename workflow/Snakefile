# Main entrypoint of the workflow.
# Please follow the best practices:
# https://snakemake.readthedocs.io/en/stable/snakefiles/best_practices.html,
# in particular regarding the standardized folder structure mentioned there.


import os


# load configuration
# -----------------------------------------------------
configfile: "config/config.yaml"


try:
    HALFSIB = dict()
    GROUP = []
    with open(config["halfsib"], "r") as f:
        for idx, line in enumerate(f, start=1):
            group = line.strip().split(",")
            group_name = f"branch{idx:02d}"
            GROUP.append(group_name)
            HALFSIB[group_name] = group

except FileNotFoundError:
    msg = f"{config["halfsib"]} not found. Please ensure it exists and is correctly formatted."
    raise FileNotFoundError(msg)


with open(config["phenotype"], "r") as f:
    line = f.readline()
    line = line.strip().split("\t")
    if line[0] != "FID" and line[1] != "IID":
        msg = "Make sure FID and IID in the first line of phenotype file. And split by tab."
        raise ValueError(msg)

PHENOTYPES = config["phenotypes"]


def normalize_chr(value):
    value = value.strip()
    if value.lower().startswith("chr"):
        value = value[3:]
    return value.lstrip("0") or "0"


# Parse one fine-mapping BED per phenotype (cols: chr start end [name]).
# Phenotypes without a BED file are skipped (no fine-mapping targets).
REGIONS = dict()
REGION_INFO = dict()
for pheno in PHENOTYPES:
    bed_path = config["regions"].format(phenotype=pheno)
    if not os.path.exists(bed_path):
        continue
    names = []
    with open(bed_path, "r") as f:
        for raw in f:
            raw = raw.strip()
            if not raw or raw.startswith("#"):
                continue
            fields = raw.split()
            chrom = normalize_chr(fields[0])
            start, end = fields[1], fields[2]
            name = fields[3] if len(fields) > 3 else f"{chrom}_{start}_{end}"
            names.append(name)
            REGION_INFO[(pheno, name)] = (chrom, start, end)
    REGIONS[pheno] = names


include: "rules/prepare.smk"
include: "rules/finemap.smk"


onstart:
    print(f"{len(GROUP)} groups found in {config['halfsib']}")
    print(f"Phenotypes with regions: {sorted(REGIONS)}")
    print(f"Total regions: {sum(len(v) for v in REGIONS.values())}")


# target rules
# -----------------------------------------------------
rule all:
    input:
        [
            f"results/{config['run_id']}/{group}/{pheno}/finemap/{region}/pip.tsv"
            for group in GROUP
            for pheno in REGIONS
            for region in REGIONS[pheno]
        ],
    default_target: True
