# Test QTL dominance-effect heterogeneity across genetic-background strata.
configfile: "config/config.yaml"


import pandas as pd

with open(config["phenotype"], "r") as f:
    header = f.readline().strip().split("\t")
    if header[:2] != ["FID", "IID"]:
        raise ValueError(
            "Phenotype file must be tab-separated and start with FID and IID."
        )
if config["qtl_scope"] not in {"all", "per_phenotype"}:
    raise ValueError("qtl_scope must be 'all' or 'per_phenotype'.")

_qtl = pd.read_csv(config["qtl_list"], sep="\t")
QTL_PHENOTYPE = [p for p in config["phenotypes"] if p in set(_qtl["PHENOTYPE"])]


include: "rules/prepare.smk"
include: "rules/qtl.smk"
include: "rules/heterogeneity.smk"


onstart:
    print(f"QTL phenotypes: {QTL_PHENOTYPE}")


rule all:
    default_target: True
    input:
        expand(
            "results/{run_id}/{phenotype}/heterogeneity/heterogeneity.tsv",
            run_id=config["run_id"],
            phenotype=QTL_PHENOTYPE,
        ),
